---
// RevealOnScroll.astro
// -----------------------------------------------------------
// Se incluye UNA vez por página (al final). Hace que cada bloque
// marcado con el atributo data-reveal aparezca con un fundido
// cuando entra en pantalla. Para escalonar varios bloques:
//   <div data-reveal style="--reveal-delay: 0.12s">
//
// El script va inline (no espera a ningún archivo JS) y es el que
// pone la clase "reveal-on" en <html>: si por lo que sea no
// corriera, el contenido se ve igual, nada queda oculto. Tampoco
// se activa si la persona pidió "reducir movimiento" en su sistema.
---

<script is:inline>
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.documentElement.classList.add('reveal-on');
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );
    document.querySelectorAll('[data-reveal]').forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style is:global>
  .reveal-on [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease var(--reveal-delay, 0s),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--reveal-delay, 0s);
  }

  .reveal-on [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
</style>
