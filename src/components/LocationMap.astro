---
// LocationMap.astro
// -----------------------------------------------------------
// Uso el embed público de Google Maps (un <iframe>, tal como
// lo pediste) apuntando a la dirección del cliente. No hace
// falta API key para este embed básico "de búsqueda" en un
// iframe, así que no dependemos de que el cliente gestione
// credenciales de Google Cloud.
const direccion = 'Thompson 309, Bahía Blanca, Buenos Aires';
const mapsSrc = `https://www.google.com/maps?q=${encodeURIComponent(direccion)}&output=embed`;
---

<section class="location section section--alt">
  <div class="container location__grid">
    <div class="location__copy">
      <p class="eyebrow">Ubicación</p>
      <h2 class="location__title">Dónde encontrarnos</h2>
      <p class="location__text">
        Thompson 309, esquina Fitz Roy — Bahía Blanca.
      </p>
      <p class="location__hours">Lunes a viernes de 8:30 a 16:30 hs</p>
      <a
        class="location__link"
        href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(direccion)}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Cómo llegar
      </a>
    </div>

    <div class="location__map">
      <iframe
        title="Ubicación de Tecnofot en Bahía Blanca"
        src={mapsSrc}
        width="100%"
        height="100%"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .location__title {
    font-size: var(--fs-h2);
    margin-top: 0.25rem;
  }

  .location__text {
    margin-top: 1rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .location__hours {
    margin-top: 0.35rem;
  }

  .location__link {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 700;
    color: var(--color-indigo);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .location__map {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 860px) {
    .location__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
    }
    .location__map {
      aspect-ratio: 16 / 11;
    }
  }
</style>
