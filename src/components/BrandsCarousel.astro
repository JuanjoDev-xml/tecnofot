---
// BrandsCarousel.astro
// -----------------------------------------------------------
// DECISIÓN: ¿React o no para el carrusel?
//
// No. Uso un "marquee" hecho con CSS puro (animación de
// translateX en loop). Los motivos:
//
// 1. Astro ya renderiza HTML estático por defecto. Si metemos
//    un componente React acá, Astro tiene que mandar al
//    navegador el runtime de React + "hidratar" ese componente
//    en el cliente, solo para mover unas imágenes de un lado
//    a otro. Es peso y complejidad que no se justifican.
// 2. Este carrusel NO necesita estado (no hay botones, no hay
//    "página actual", nadie hace click para cambiar de marca).
//    Es 100% decorativo/automático -> es el caso de uso ideal
//    para CSS/JS plano, y el caso menos ideal para React.
// 3. Regla general que te sirve para el resto del proyecto:
//    usá React (o cualquier framework de UI) cuando un
//    componente tiene ESTADO que cambia por interacción del
//    usuario (un acordeón que se abre/cierra, un formulario
//    con validaciones en vivo, un contador). Para animaciones
//    automáticas o efectos visuales, CSS/JS puro alcanza y
//    carga más rápido.
//
// Técnica: duplicamos la lista de logos una vez (brands + brands)
// y animamos todo el contenedor con translateX(-50%) en loop
// infinito. Como la segunda mitad es idéntica a la primera, el
// "corte" del loop es invisible para el ojo.
interface Brand {
  name: string;
  logo: string;
  // Opcional: por si en el futuro necesitás agrandar/achicar UN
  // logo puntual sin tocar el tamaño base de todos los demás.
  // 1 = tamaño normal, 1.4 = 40% más grande, 0.8 = 20% más chico.
  scale?: number;
}

interface Props {
  brands: Brand[];
}

const { brands } = Astro.props;
const track = [...brands, ...brands, ...brands]; // duplicado para el loop infinito
---

<section class="brands" id="marcas">
  <div class="container brands__intro">
    <p class="eyebrow">Marcas</p>
    <h2 class="brands__title">Trabajamos con las siguientes marcas</h2>
    <p class="brands__subtitle">Equipos chicos, medianos y grandes</p>
  </div>

  <div class="brands__viewport" role="group" aria-label="Marcas con las que trabajamos">
    <div class="brands__track">
      {track.map((b) => (
        <a
          href={`/marcas/${b.name.toLowerCase().replace(/\s+/g, '-')}`}
          class="brands__item"
          style={`--logo-scale: ${b.scale ?? 1}`}
          aria-label={b.name}
        >
          <img src={b.logo} alt={b.name} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .brands {
    padding-block: var(--space-section);
    overflow: hidden;
    /* Fondo SIEMPRE blanco, sin importar el tema: la mayoría de
       los logos de marca vienen pensados para fondo claro (texto
       o detalles en negro/gris oscuro), así que si el sitio está
       en modo oscuro y esta sección heredara el fondo oscuro de
       la página, los logos se volverían ilegibles. Por eso NO
       usamos --color-bg (que cambia con el tema) sino
       --color-paper, que es un blanco fijo. */
    background: var(--color-bg);
  }

  /* Como el fondo de esta sección es SIEMPRE blanco, el texto de
     adentro también tiene que ser fijo (oscuro) en vez de seguir
     el tema: si usáramos var(--color-text) normal, en modo
     oscuro ese texto sería claro -> texto claro sobre fondo
     blanco, ilegible. Esta regla tiene más especificidad que la
     de global.css (Astro le agrega un atributo de "scoping" acá
     adentro), así que gana sin necesitar !important. */
  .brands__intro .eyebrow {
    color: var(--color-cyan-dim);
  }

  .brands__title {
    color: var(--color-text);
  }

  .brands__subtitle {
    color: var(--color-text-soft);
  }

  .brands__intro {
    text-align: center;
    margin-bottom: 3rem;
  }

  .brands__title {
    font-size: var(--fs-h2);
  }

  .brands__subtitle {
    margin-top: 0.6rem;
    font-size: 1.05rem;
  }

  .brands__viewport {
    background: var(--color-paper);
    padding-top: 10px;
    padding-bottom: 10px;
    /* mask: difumina los bordes izquierdo/derecho para que las
       marcas "aparezcan/desaparezcan" en vez de cortarse feo */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .brands__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(2.5rem, 6vw, 5rem);
    animation: scroll-left 50s linear infinite;
  }

  .brands__viewport:hover .brands__track {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    /* -50% porque la lista está duplicada: al llegar a la mitad
       exacta, visualmente se ve idéntico al inicio -> loop perfecto */
    to { transform: translateX(-50%); }
  }

  .brands__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 112px = el tamaño base (antes 56px, ahora el doble) x
       --logo-scale (1 por defecto, se puede pisar por marca) */
    height: calc(112px * var(--logo-scale, 1));
  }

  .brands__item img {
    height: 100%;
    width: auto;
    max-width: calc(300px * var(--logo-scale, 1));
    object-fit: contain;
    /* Logos en escala de grises por defecto, color al pasar el
       mouse: mantiene la fila prolija y "seria" y da un pequeño
       feedback interactivo sin sumar ruido visual. */
    filter: grayscale(1) opacity(0.55);
    transition: filter 0.25s ease;
  }

  .brands__item:hover img,
  .brands__item:focus-visible img {
    filter: grayscale(0) opacity(1);
  }

  /* (hover: none) detecta dispositivos SIN capacidad de hover real
     -> básicamente pantallas táctiles (celulares, tablets), sin
     importar el ancho de pantalla. Es más preciso que un media
     query por tamaño (ej. max-width: 768px), porque lo que nos
     interesa es "¿este dispositivo puede hacer hover?" y no
     "¿la pantalla es angosta?" (una notebook con pantalla táctil,
     por ejemplo, sigue teniendo mouse). Ahí mostramos los logos
     a color directamente, porque el usuario nunca va a poder
     "pasar el mouse" para revelarlos. */
  @media (hover: none) {
    .brands__item img {
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brands__track {
      animation: none;
    }
  }
</style>