---
import Layout from "../layouts/Layout.astro"
---

<Layout title="TECNOFOT | Insumos">
    <div class="under-construction">
        <div class="construction-card">
          <div class="construction-icon">🚧</div>
          <h2>Sección en Construcción</h2>
          <p>Estoy trabajando en esta funcionalidad. ¡Vuelva pronto!</p>
        </div>
      </div>
      
      <style>
        .under-construction {
          display: flex;
          justify-content: center;
          align-items: center;
          min-height: 400px;
          padding: 2rem;
          text-align: center;
          margin-top: 63px;
        }
      
        .construction-card {
          border: 2px dashed #eab308;
          background-color: #fefce8;
          color: #713f12;
          padding: 2.5rem 2rem;
          border-radius: 1rem;
          max-width: 480px;
          box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
      
        .construction-icon {
          font-size: 3.5rem;
          margin-bottom: 1rem;
          animation: bounce 2s infinite;
        }
      
        .construction-card h2 {
          font-size: 1.5rem;
          font-weight: 700;
          margin-bottom: 0.5rem;
          color: black;
        }
      
        .construction-card p {
          font-size: 0.95rem;
          color: #854d0e;
          margin: 0;
        }
      
        @keyframes bounce {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-8px); }
        }
      </style>
</Layout>