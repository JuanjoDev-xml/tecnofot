---
// nosotros.astro
// -----------------------------------------------------------
// Tres bloques: quiénes somos (foto + texto), la trayectoria
// (1985 -> hoy) y el compromiso medioambiental.
//
// Los textos son los del cliente. Lo único que cambia es CÓMO
// están repartidos: su párrafo original de "quiénes somos" está
// partido en tres (introducción / los inicios / hoy) para poder
// mostrar la historia como una línea de tiempo en vez de un solo
// bloque largo de texto.
import Layout from '../layouts/Layout.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';

const anioFundacion = 1985;
const anios = new Date().getFullYear() - anioFundacion;

// La segunda mitad del texto medioambiental del cliente es una
// enumeración: la mostramos como lista, se lee mucho más rápido.
const alternativa = [
  'Copiadoras e impresoras digitales y conectables a red',
  'Remanufactura de cartuchos láser',
  'Planeras y faxes',
  'Nuestro respaldo en el servicio técnico',
];
---

<Layout title="TECNOFOT | Nosotros">
  <main class="nosotros">
    <!-- ============ BLOQUE 1: Quiénes somos ============ -->
    <section class="intro">
      <span class="intro__dots" aria-hidden="true"></span>

      <div class="container intro__grid">
        <div class="intro__media" data-reveal>
          <img
            src="/images/local-tecnofot.webp"
            alt="Frente del local de Tecnofot"
            width="1200"
            height="900"
          />
          <p class="intro__badge">
            <strong>{anios} años</strong>
            <span>desde {anioFundacion}</span>
          </p>
        </div>

        <div class="intro__text" data-reveal style="--reveal-delay: 0.12s">
          <p class="eyebrow">Nosotros</p>
          <h1 class="intro__title">Quiénes <span class="registro">somos</span></h1>
          <p class="intro__paragraph">
            Tecnofot SA, es una empresa que inicio sus actividades en 1985, somos una de las
            empresas más antiguas conocidas en el rubro en Bahía Blanca y la zona, en todo este
            tiempo la empresa se fue adaptando a los cambios de mercado, tecnología y necesidades
            de los clientes usuarios.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ BLOQUE 2: Trayectoria ============
         Una línea con los 4 colores de impresión une los dos
         momentos; se "dibuja" de izquierda a derecha al aparecer. -->
    <section class="historia section section--alt">
      <div class="container">
        <header class="historia__intro" data-reveal>
          <p class="eyebrow">Trayectoria</p>
          <h2 class="historia__title">De las fotocopiadoras a las soluciones integrales</h2>
        </header>

        <ol class="historia__track" data-reveal>
          <li class="historia__item">
            <span class="historia__year registro">{anioFundacion}</span>
            <h3 class="historia__label">Los inicios</h3>
            <p>
              En sus inicios los equipos solo eran copiadores. El foco de la empresa estaba puesto
              solo en fotocopiadoras, es lo que mercado demandaba, y lo que tecnológicamente existía.
            </p>
          </li>
          <li class="historia__item">
            <span class="historia__year registro">Hoy</span>
            <h3 class="historia__label">{anios} años después</h3>
            <p>
              Hoy ofrecemos soluciones integrales para el manejo de documentos, desde necesidades
              de copiado/ impresión a digitalización, identificación profesional con equipos
              corporativos y de gran formato.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ BLOQUE 3: Compromiso medioambiental ============
         El dibujo es literal: el verde no existe como tinta, sale
         de imprimir cian sobre amarillo. Dos círculos de tinta se
         juntan y donde se pisan aparece el verde, con la hoja. -->
    <section class="eco section">
      <div class="container eco__grid">
        <div class="eco__visual" data-reveal>
          <div class="eco__paper">
            <span class="eco__crop eco__crop--tl" aria-hidden="true"></span>
            <span class="eco__crop eco__crop--tr" aria-hidden="true"></span>
            <span class="eco__crop eco__crop--bl" aria-hidden="true"></span>
            <span class="eco__crop eco__crop--br" aria-hidden="true"></span>

            <div class="eco__inks" aria-hidden="true">
              <span class="eco__ink eco__ink--c"></span>
              <span class="eco__ink eco__ink--y"></span>
              <svg class="eco__leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 4c-8 0-14 5-14 13 0 1 .8 2 2 2 8 0 13-6 13-14 0-.5-.4-1-1-1Z" />
                <path d="M8 19c0-5 3-9 8-11" />
              </svg>
            </div>

            <p class="eco__formula" aria-hidden="true">Cian + amarillo = verde</p>
          </div>
        </div>

        <div class="eco__text">
          <div data-reveal>
            <p class="eyebrow eco__eyebrow">Medioambiente</p>
            <h2 class="eco__title">Compromiso medioambiental</h2>
          </div>

          <p class="eco__lead" data-reveal style="--reveal-delay: 0.08s">
            Que nuestra compañía y el medioambiente evolucionen en armonía.
          </p>

          <p class="eco__paragraph" data-reveal style="--reveal-delay: 0.14s">
            Nuestra empresa también está inserta en promover la responsabilidad medioambiental en
            todos los niveles, tanto dentro como fuera de la compañía. El trabajo continuo es el
            intento de reducir el impacto medioambiental, y es por tal motivo que estamos
            comprometidos con la puesta en marcha de sistemas globales de gestión medioambiental
            que cubren las actividades de la empresa, con el objeto de asegurar que nuestra
            compañía y el medioambiente evolucionen en armonía.
          </p>

          <div class="eco__alt" data-reveal style="--reveal-delay: 0.2s">
            <p class="eco__alt-title">
              Presentamos a ustedes, de esta manera, una alternativa diferente en el mercado de:
            </p>
            <ul class="eco__list">
              {alternativa.map((item) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <RevealOnScroll />
</Layout>

<style>
  .nosotros {
    --header-height: 63px; /* el Header es fixed: sin esto taparía el título */
    /* Verde de sobreimpresión: el que da el cian encima del
       amarillo. En tema oscuro va una versión más clara para que
       se lea como texto. */
    --eco-green: #3ecf7a;
  }

  :global([data-theme='light']) .nosotros {
    --eco-green: #00934a;
  }

  /* "Fuera de registro": las tintas corridas apenas, la misma
     firma que el título del home. */
  .registro {
    text-shadow:
      -0.03em 0 0 var(--ink-c),
      0.03em 0.012em 0 var(--ink-m),
      0 0.035em 0 color-mix(in srgb, var(--ink-y) 85%, transparent);
  }

  /* ---------- Bloque 1: quiénes somos ---------- */
  .intro {
    position: relative;
    padding-block: calc(var(--header-height) + clamp(2.5rem, 6vw, 4.5rem)) var(--space-section);
    overflow: hidden;
  }

  .intro__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--color-text) 1.1px, transparent 1.7px);
    background-size: 16px 16px;
    opacity: 0.1;
    -webkit-mask-image: radial-gradient(ellipse 50% 80% at 100% 20%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 50% 80% at 100% 20%, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .intro__grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .intro__grid {
      grid-template-columns: 0.9fr 1fr;
      gap: 4.5rem;
    }
  }

  .intro__media {
    position: relative;
    margin: 12px; /* lugar para el marco corrido de abajo */
  }

  /* Marco fuera de registro: dos copias del rectángulo de la foto
     (cian y magenta) corridas para lados opuestos. Al pasar el
     mouse se acomodan detrás, como una impresión que se calibra. */
  .intro__media::before,
  .intro__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .intro__media::before {
    background: var(--ink-c);
    transform: translate(-12px, -12px);
  }

  .intro__media::after {
    background: var(--ink-m);
    transform: translate(12px, 12px);
  }

  .intro__media:hover::before,
  .intro__media:hover::after {
    transform: none;
  }

  .intro__media img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
  }

  .intro__badge {
    position: absolute;
    z-index: 2;
    right: -0.75rem;
    bottom: 1.5rem;
    display: grid;
    padding: 0.7rem 1rem;
    border-radius: 12px;
    background: var(--ink-y);
    color: #14161f;
    line-height: 1.15;
    box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.5);
  }

  .intro__badge strong {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .intro__badge span {
    font-size: 0.78rem;
    font-weight: 600;
  }

  .intro__title {
    font-size: clamp(2.4rem, 4.6vw + 0.8rem, 4rem);
  }

  .intro__paragraph {
    margin-top: 1.4rem;
    font-size: 1.1rem;
    line-height: 1.75;
    max-width: 52ch;
  }

  /* ---------- Bloque 2: trayectoria ---------- */
  .historia__intro {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .historia__title {
    font-size: var(--fs-h2);
  }

  .historia__track {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  /* La línea: 4 tramos, uno por tinta. En el celular va vertical,
     a la izquierda; en desktop, horizontal arriba. */
  .historia__track::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(
      180deg,
      var(--ink-c) 0 25%,
      var(--ink-m) 25% 50%,
      var(--ink-y) 50% 75%,
      var(--color-text) 75% 100%
    );
    transform-origin: 0 0;
    transition: transform 1.2s cubic-bezier(0.3, 0.6, 0.2, 1) 0.25s;
  }

  :global(.reveal-on) .historia__track:not(.is-visible)::before {
    transform: scaleY(0);
  }

  .historia__item {
    position: relative;
    padding-left: 2rem;
  }

  /* El punto de cada momento sobre la línea */
  .historia__item::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.9rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    border: 4px solid var(--ink-c);
  }

  .historia__item:last-child::before {
    border-color: var(--color-text);
  }

  .historia__year {
    display: block;
    font-size: clamp(2.6rem, 6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
  }

  .historia__label {
    margin-top: 0.75rem;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .historia__item p {
    margin-top: 0.7rem;
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 46ch;
  }

  @media (min-width: 800px) {
    .historia__track {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-top: 2.75rem;
    }

    .historia__track::before {
      width: 100%;
      height: 4px;
      background: linear-gradient(
        90deg,
        var(--ink-c) 0 25%,
        var(--ink-m) 25% 50%,
        var(--ink-y) 50% 75%,
        var(--color-text) 75% 100%
      );
    }

    :global(.reveal-on) .historia__track:not(.is-visible)::before {
      transform: scaleX(0);
    }

    .historia__item {
      padding-left: 0;
    }

    .historia__item::before {
      left: 0;
      top: calc(-2.75rem - 6px);
    }

    /* "Hoy" es el final de la línea: su punto va en el extremo derecho */
    .historia__item:last-child::before {
      left: auto;
      right: 0;
    }
  }

  /* ---------- Bloque 3: compromiso medioambiental ---------- */
  .eco__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .eco__grid {
      grid-template-columns: 0.8fr 1fr;
    }
  }

  .eco__paper {
    position: relative;
    width: min(100%, 400px);
    margin-inline: auto;
    padding: 9% 9% 6%;
    background: #fff;
    border-radius: 6px;
    box-shadow:
      0 0 0 1px rgba(20, 22, 31, 0.08),
      0 30px 60px -28px rgba(0, 0, 0, 0.55);
    transform: rotate(-3deg);
  }

  .eco__crop {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid #14161f;
    opacity: 0.55;
  }
  .eco__crop--tl { top: 10px; left: 10px; border-top-width: 1.5px; border-left-width: 1.5px; }
  .eco__crop--tr { top: 10px; right: 10px; border-top-width: 1.5px; border-right-width: 1.5px; }
  .eco__crop--bl { bottom: 10px; left: 10px; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .eco__crop--br { bottom: 10px; right: 10px; border-bottom-width: 1.5px; border-right-width: 1.5px; }

  .eco__inks {
    position: relative;
    aspect-ratio: 1.45;
    /* isolation: el "multiply" de los círculos se mezcla solo
       contra el papel blanco, no contra lo que haya detrás. */
    isolation: isolate;
  }

  .eco__ink {
    position: absolute;
    top: 50%;
    width: 62%;
    aspect-ratio: 1;
    margin-top: -31%;
    border-radius: 50%;
    /* multiply = así se mezclan las tintas en el papel: donde el
       cian pisa al amarillo queda verde. */
    mix-blend-mode: multiply;
    transition: transform 1.5s cubic-bezier(0.3, 0.6, 0.2, 1) 0.35s;
  }

  .eco__ink--c {
    left: 4%;
    background: var(--ink-c);
  }

  .eco__ink--y {
    right: 4%;
    background: var(--ink-y);
  }

  /* Antes de aparecer están separadas; al entrar en pantalla se
     juntan. (Si no hay animaciones, quedan juntas de entrada.) */
  :global(.reveal-on) .eco__visual:not(.is-visible) .eco__ink--c {
    transform: translateX(-34%);
  }
  :global(.reveal-on) .eco__visual:not(.is-visible) .eco__ink--y {
    transform: translateX(34%);
  }

  .eco__leaf {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 19%;
    transform: translate(-50%, -50%);
    color: #fff;
    transition: opacity 0.6s ease 1.3s, transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1.3) 1.3s;
  }

  :global(.reveal-on) .eco__visual:not(.is-visible) .eco__leaf {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5) rotate(-25deg);
  }

  .eco__formula {
    margin-top: 6%;
    text-align: center;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5a6072;
  }

  .eco__eyebrow {
    color: var(--eco-green);
  }

  .eco__title {
    font-size: var(--fs-h2);
  }

  .eco__lead {
    margin-top: 1.5rem;
    padding-left: 1.1rem;
    border-left: 4px solid var(--eco-green);
    font-size: clamp(1.25rem, 1.6vw + 0.8rem, 1.6rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
    max-width: 24ch;
  }

  .eco__paragraph {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 58ch;
  }

  .eco__alt {
    margin-top: 2rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .eco__alt-title {
    font-weight: 700;
    color: var(--color-text);
  }

  .eco__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  @media (min-width: 560px) {
    .eco__list {
      grid-template-columns: 1fr 1fr;
      gap: 0.8rem 1.5rem;
    }
  }

  .eco__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--color-text-soft);
  }

  .eco__list svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--eco-green);
  }
</style>
