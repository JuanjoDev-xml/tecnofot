---
// Layout.astro
// -----------------------------------------------------------
// Este es el "molde" que va a envolver TODAS las páginas del
// sitio (index.astro hoy, y mañana /nosotros, /servicios y las
// 5 páginas de marcas). En vez de repetir el <head>, el Header
// y el Footer en cada página, cada página futura va a hacer:
//
//   ---
//   import Layout from '../layouts/Layout.astro';
//   ---
//   <Layout title="Nosotros | Tecnofot">
//     ...el contenido de esa página...
//   </Layout>
//
// Esto es lo que en Astro se llama un "layout": un componente
// que recibe contenido adentro (con <slot />) y le agrega la
// estructura común.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Tecnofot — soluciones en impresión y digitalización de documentos en Bahía Blanca.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <!--
      Script "anti-flash" del tema.
      -----------------------------------------------------------
      Por qué existe ESTE script, separado del de ThemeToggle.astro:

      Sin él, la secuencia sería: (1) la página carga y se pinta
      con el tema oscuro por defecto (los valores base de
      :root en global.css), (2) recién después se ejecuta el
      script de ThemeToggle, lee localStorage, y si el usuario
      había elegido "claro" ahí recién cambia el atributo. Ese
      "recién después" alcanza a pintarse en pantalla -> el
      usuario ve un flash oscuro que enseguida cambia a claro.

      Este script en cambio corre ACÁ, arriba de todo el <head>,
      de forma síncrona (is:inline evita que Astro lo mueva o lo
      difiera) -> el navegador lo ejecuta antes de pintar nada,
      así que el atributo data-theme ya está bien puesto desde
      el primer frame. Es la misma técnica que usan la mayoría
      de los sitios con modo oscuro/claro.
    -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('tecnofot-theme');
        var theme = saved === 'light' ? 'light' : 'dark'; // dark = default pedido
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Header />
    <!-- El <slot /> es donde Astro inyecta el contenido específico
         de cada página (Hero, secciones, etc.) -->
    <slot />
    <Footer />
  </body>
</html>